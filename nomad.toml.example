# NØMAÐ Configuration File
# Copy this file to nomade.toml and customize for your environment

# ============================================
# GENERAL SETTINGS
# ============================================

[general]
# Name of this cluster (used in alerts and reports)
cluster_name = "my-cluster"

# Directory for NØMAÐ data (database, logs)
data_dir = "/var/lib/nomade"

# Log level: DEBUG, INFO, WARNING, ERROR
log_level = "INFO"

# Log file (empty for stdout only)
log_file = "/var/log/nomade/nomade.log"

# Daemon PID file
pid_file = "/var/run/nomade/nomade.pid"

# ============================================
# COLLECTORS
# ============================================

[collectors]
# Each collector is turned on or off in its own table:
#
#   [collectors.nfs]
#   enabled = false
#
# On unless turned off: disk, slurm, job_metrics, iostat, mpstat, vmstat,
#   node_state, gpu, nfs, groups
# Off unless turned on: interactive, workstation, per_user, storage,
#   network_perf, cloud.aws
#
# (An `enabled = [...]` list here is not read.) `nomad collectors` shows,
# on any host, which ones run, why, and whether they collect anything.

# Default collection interval in seconds. Each [collectors.<name>]
# subtable can override this with its own `interval = N`.

# ============================================
# DISK COLLECTOR
# ============================================

[collectors.disk]
interval = 300  # Every 5 minutes
# Filesystems to monitor
filesystems = [
    "/",
    "/home",
    "/scratch",
    # "/project",
]

# Enable quota tracking
quota_enabled = true

# Command to get quota information
# Options: "quota", "lfs quota" (Lustre), "custom"
quota_backend = "quota"

# For custom quota command
# quota_command = "/usr/local/bin/get_quota.sh"

# Fill forecast: each reading fits the last N hours of readings with a line
# and says when the filesystem will be full ([alerts.thresholds.disk]).
forecast_window_hours = 6

# Large file detection
large_file_threshold_gb = 100
scan_for_large_files = false  # Can be slow on large filesystems

# ============================================
# SLURM COLLECTOR
# ============================================

[collectors.slurm]
interval = 60   # Every minute
# Path to SLURM commands (if not in PATH)
# slurm_bin_path = "/usr/bin"

# Partitions to monitor (empty = all)
partitions = []

# Job age limit for history queries (days)
job_history_days = 30

# Stuck job threshold (days)
stuck_job_threshold_days = 7

# Zombie process detection
check_zombies = true

# ============================================
# NODE COLLECTOR
# ============================================

[collectors.nodes]
interval = 120  # Every 2 minutes
# How to check node health
# Options: "slurm" (sinfo only), "ssh" (SSH to each node)
health_check_method = "slurm"

# SSH settings (if health_check_method = "ssh")
ssh_user = "root"
ssh_timeout = 10
ssh_parallel = 4

# Temperature monitoring
monitor_temperatures = true
cpu_temp_warning = 80
cpu_temp_critical = 90
gpu_temp_warning = 83
gpu_temp_critical = 90

# NFS health check
check_nfs_mounts = true
nfs_mount_points = ["/home", "/scratch"]

# Services to check (via systemctl)
check_services = ["slurmd", "munge"]

# ============================================
# LICENSE COLLECTOR
# ============================================

[collectors.licenses]
interval = 300  # Every 5 minutes
# License servers to monitor

[[collectors.licenses.servers]]
name = "matlab"
type = "flexlm"           # flexlm, rlm, or custom
host = "license.example.edu"
port = 27000
timeout = 10

[[collectors.licenses.servers]]
name = "gaussian"
type = "flexlm"
host = "license.example.edu"
port = 27001

# [[collectors.licenses.servers]]
# name = "custom_software"
# type = "custom"
# command = "/usr/local/bin/check_license.sh"
# parse_regex = "Available: (\\d+)/(\\d+)"

# ============================================
# JOB COLLECTOR
# ============================================

[collectors.jobs]
# Job metrics are collected via SLURM prolog/epilog hooks
# See scripts/prolog.sh and scripts/epilog.sh

# Path where prolog/epilog write temporary data
metrics_spool_dir = "/var/spool/nomade/jobs"

# Sample job metrics during execution (requires periodic cron job)
sample_during_job = false
sample_interval = 300  # seconds

# cgroup path for per-job metrics
cgroup_path = "/sys/fs/cgroup"

# GPU monitoring
monitor_gpus = true
nvidia_smi_path = "/usr/bin/nvidia-smi"


# ============================================
# WORKSTATION COLLECTOR
# ============================================
[collectors.workstation]
# Enable workstation monitoring
enabled = false

# Collection interval (seconds)
interval = 300

# List of workstations to monitor
# Each workstation needs hostname and optional department. A department that
# is a lab's group (e.g. "NETID$") assigns the machine to that lab: its PI
# sees it in the Console (see [console.labs]).
[[workstations]]
hostname = "ws-physics-01"
department = "physics"

[[workstations]]
hostname = "ws-chem-lab"
department = "chemistry"

[[workstations]]
hostname = "ws-bio-analysis"
department = "biology"

# SSH settings for remote collection
ssh_timeout = 10
ssh_batch_mode = true

# ============================================
# STORAGE/NAS COLLECTOR
# ============================================
[collectors.storage]
# Enable storage/NAS monitoring
enabled = false

# Collection interval (seconds)
interval = 300

# Storage servers to monitor, reached over SSH (BatchMode: a key, no
# password prompt) unless the hostname is this host. type = "zfs" reads
# pool health and capacity (zpool); any type reads NFS exports. Capacity
# without ZFS comes from `paths` (df), never from the server's root disk.
[[collectors.storage.storage_devices]]
hostname = "nas-01"
type = "zfs"
description = "Primary ZFS storage"

[[collectors.storage.storage_devices]]
hostname = "nfs-home"
type = "nfs"
paths = ["/export/home"]
description = "Home directories NFS server"

# ZFS-specific settings
[collectors.storage.zfs]
# Monitor ARC statistics
monitor_arc = true
# Alert on scrub errors
scrub_error_alert = true
# Alert when pool capacity exceeds this percentage
capacity_warning = 80
capacity_critical = 90

# NFS-specific settings
[collectors.storage.nfs]
# Monitor NFS client connections
monitor_clients = true
# Monitor export status
monitor_exports = true

# ============================================
# PER-USER COLLECTOR (login nodes, shared hosts)
# ============================================
# Who uses this host heavily, with what, for how long. Each run averages
# CPU and I/O over the interval since the previous run; `nomad per-user`
# shows what was flagged and who used the host most.
[collectors.per_user]
enabled = false
role = "headnode"

# A process is stored (with its command line) only above one of these;
# the rest leave no row. Flags and daily per-user totals are kept; raw
# samples for sample_retention_days (0 keeps them).
floor_cpu_percent = 10
floor_memory_gb = 2
floor_io_mb_per_s = 10
sample_retention_days = 30

# Per-user CPU from systemd user slices (cgroups) where present: it also
# counts processes too short-lived to be seen between two readings.
user_slices = true

[collectors.per_user.whitelist]
min_uid = 1000                     # below this: system accounts, never flagged
users = ["slurm", "munge"]
parent_paths = ["/usr/local/sw/"]  # matched against the executable (needs root for
                                   # other users') or the script an interpreter runs
# user_commands = [["backupuser", "clusterbackup.py"]]   # command or script name

# Rules replace the defaults when given. rule_type: cpu, memory, io (one
# process), user_cpu, user_memory (all of a user's processes together).
# threshold: % of one core, GB, or MB/s. duration_seconds is a minimum.
# [[collectors.per_user.rules]]
# rule_id = "cpu_50pct_2min"
# rule_type = "cpu"
# threshold = 50
# duration_seconds = 120
# severity = "actionable"          # or "informational"

# ============================================
# MAIL, SUPPORT AND ISSUE REPORTING
# ============================================
# These differ from one institution to the next. The CLI, the dashboard and
# the NØMAÐ Console all read them from here.

# ─── Mail ────────────────────────────────────────────────────────
# How NØMAÐ hands mail to your institution's mail server: alert email,
# and support messages sent from the Console.
[mail]
host = "smtp.your-institution.edu"
port = 587                   # often 25 for an on-campus relay, 587 otherwise
starttls = "required"        # required | if-offered | off. "off" is meant
                             # for a mail server on this machine.
from = "hpc@your-institution.edu"   # must be an address the server accepts;
                                    # some refuse senders not in the directory
# tls_name = ""              # the name on the server's certificate, when it
                             # differs from host (a pool presenting the pool's
                             # certificate)
# extra_ca = ""              # an intermediate certificate the server fails
                             # to send; the chain must still reach a trusted root
# ca_bundle = ""             # trusted roots; default: the operating system's
# username = ""              # only if the server needs a login
# password_file = ""         # a file holding that password, readable only by
                             # you -- never the password itself

# ─── Console access ──────────────────────────────────────────────
# Who may see what in the Console, on the machine that runs it. Anyone not
# named who signs in is a viewer: their own work. Check with
# `nomad console roles NETID`.
[console.roles]
admin = []                   # NetIDs: everything, settings included
operator = []                # everything, no settings

[console.labs]
# A PI also sees the members of the labs they lead: the group named by
# group_pattern for them (when it exists), and any group listed in leads.
# Empty (the default): no labs from names, only from leads.
group_pattern = ""           # e.g. "{netid}$" where a faculty member's group
                             # is their NetID followed by $
leads = {}                   # e.g. { NETID = ["chemlab$"] }

# A lab's own workstations and storage, which its PI also sees (people
# outside the lab show as "another user" there). One table per lab group:
# [console.labs.resources."NETID$"]
# workstations = ["adam", "eve"]
# storage = ["sarahvaughan"]           # a server, or "server:/export"

# A storage server's name and a note, shown wherever its exports are. The
# server as the mounts name it (often an address). Say when everyone shares
# it, or its use reads as the lab's own.
# [console.storage."10.0.0.28"]
# name = "sarahvaughan"
# note = "community $HOME, all users"

# ─── Support ─────────────────────────────────────────────────────
# Where people's questions go, e.g. the Console's "Contact support".
[support]
email = "hpc-support@your-institution.edu"
institution = "Your Institution"     # shown in reports and system information
# user_email_domain = "your-institution.edu"   # replies go to
                                               # <username>@<this domain>

# ─── Issue reporting ─────────────────────────────────────────────
# Bug reports and feature requests to the NØMAÐ project on GitHub
# (`nomad issue`, and the Console's Report Issue page for administrators).
[issue_reporting]
enabled = true
# github_token_file = ""     # a file holding a fine-grained token that can
                             # only create issues; without one, NØMAÐ opens
                             # a pre-filled page in the browser instead
# contact_email = ""         # who the NØMAÐ maintainers may reply to

# ============================================
# ALERTS
# ============================================

[alerts]
# Alert dispatch configuration.
#
# Only signals at or above min_severity are dispatched. Each condition (a
# disk path, a mount, a GPU, a node) is raised when it appears or gets
# worse, then reminded of once every reminder_hours while it lasts -- not on
# every collection run. Not seen for episode_gap_minutes, it has ended.
min_severity = "warning"     # info | warning | critical
reminder_hours = 24
episode_gap_minutes = 60

# ─── Email dispatch ──────────────────────────────────────────────
# Sent through [mail] above. To enable: fill in [mail], put your
# address in recipients, then set enabled = true.
[alerts.email]
enabled = false
recipients = ["hpc-admin@your-institution.edu"]
# Only if alerts must go through a different server than [mail]: any of
# [mail]'s keys here (host, port, starttls, from, ...) override it.

# ─── Slack dispatch ──────────────────────────────────────────────
[alerts.slack]
enabled = false
webhook_url = ""             # paste your Slack incoming webhook URL
channel = "#hpc-alerts"
username = "NØMAÐ"

# ─── Generic webhook ─────────────────────────────────────────────
[alerts.webhook]
enabled = false
url = ""
# auth_token = ""             # passed as Authorization: Bearer <token>

# ============================================
# ALERT THRESHOLDS
# ============================================

[alerts.thresholds.disk]
used_percent_warning = 80
used_percent_critical = 95
# Forecast: full within this many hours at the fill rate of the last
# forecast_window_hours ([collectors.disk], default 6).
full_within_hours_warning = 72
full_within_hours_critical = 24
# Past used_percent_critical, only when full within this many hours.
full_within_hours_past_critical = 6

[alerts.thresholds.nfs]
retrans_percent_warning = 1.0
retrans_percent_critical = 5.0
avg_rtt_ms_warning = 50
avg_rtt_ms_critical = 100

# Node state alerts (down, drained, failing) come from the node_state
# collector and need no thresholds.

# ============================================
# DERIVATIVE ALERT THRESHOLDS
# ============================================

[alerts.derivatives]
# Disk acceleration (GB/day²)
disk_acceleration_warning = 1.0
disk_acceleration_critical = 5.0

# Queue acceleration (jobs/hour²)
queue_acceleration_warning = 5
queue_acceleration_critical = 20

# Failure rate acceleration
failure_rate_acceleration_warning = 0.01  # 1% increase per day

# NFS latency acceleration (ms/hour²)
nfs_latency_acceleration_warning = 1.0

# ============================================
# PREDICTION ENGINE
# ============================================

[prediction]
# Enable/disable prediction features
enabled = true

# Minimum jobs before training models
min_jobs_for_training = 100

# Similarity threshold for network edges
similarity_threshold = 0.85

# Health score threshold for success/failure classification
health_threshold = 0.5

# Model retraining interval (days)
retrain_interval_days = 7

# Maximum jobs to keep in similarity network
max_network_jobs = 10000

# Anomaly detection threshold (distance to nearest simulation)
anomaly_distance_threshold = 0.15

# ============================================
# SIMULATION
# ============================================

[prediction.simulation]
# Number of simulated jobs for coverage analysis
n_simulated = 1000

# Rerun simulation on this interval (days)
simulation_interval_days = 7

# Alert if coverage drops below threshold
coverage_warning_percent = 90

# ============================================
# DASHBOARD
# ============================================

[dashboard]
# Web dashboard settings
enabled = true
# Bind to loopback by default. Set to "0.0.0.0" to expose to other
# hosts on the network (e.g. for centralized monitoring servers).
host = "127.0.0.1"
port = 8080

# Authentication (optional)
auth_enabled = false
# auth_users = { admin = "hashed_password" }

# SSL (optional)
ssl_enabled = false
# ssl_cert = "/etc/ssl/certs/nomade.crt"
# ssl_key = "/etc/ssl/private/nomade.key"

# Real-time update interval (milliseconds)
update_interval_ms = 5000

# ============================================
# DATA RETENTION
# ============================================

[retention]
# How long to keep historical data

# Filesystem snapshots
filesystem_days = 365

# Node metrics
node_metrics_days = 90

# Job data
job_data_days = 365

# Alerts
alert_days = 180

# Similarity edges (can be large)
similarity_days = 90

# Run cleanup on this schedule (cron format)
cleanup_schedule = "0 3 * * *"  # 3 AM daily

# ============================================
# INTERACTIVE SERVERS
# ============================================

[interactive]
# Monitor interactive computing servers (RStudio, Jupyter)
# These are non-SLURM servers where users run sessions directly
enabled = false

# Collection interval (seconds)
collect_interval = 300  # Every 5 minutes

# Thresholds for alerts
idle_session_hours = 24      # Sessions idle longer than this are "stale"
memory_hog_mb = 4096         # Sessions using more than this are flagged
max_idle_sessions = 5        # Users with more idle sessions get flagged

# Define interactive servers to monitor
# Each server needs a unique identifier

# [[interactive.servers]]
# id = "interactive-server-1"
# name = "Interactive Server"
# description = "RStudio and Jupyter server"
# 
# # Connection method: "local" (run on this machine) or "ssh" (remote)
# method = "local"
# 
# # SSH settings (only if method = "ssh")
# # ssh_host = "server.example.edu"
# # ssh_user = "nomade"
# # ssh_key = "/home/nomade/.ssh/id_rsa"
# # ssh_timeout = 30

# ============================================
# NETWORK PERFORMANCE COLLECTOR
# ============================================
# Latency and packet loss from this host to the hosts you list, every run
# (ten pings, about two seconds per path). Throughput only if you turn it
# on: it puts real traffic on the wire for iperf_duration seconds, at most
# once per throughput_interval per path, and needs `iperf3 -s` running on
# the destination (otherwise it times an SSH copy, which encryption may
# limit below what the network carries).
# For NFS client statistics, see [collectors.nfs] (nfsiostat).

[collectors.network_perf]
enabled = false
ping_count = 10

throughput = false
throughput_interval = 3600   # seconds between throughput tests, per path
iperf_duration = 10

# Full fileiotest mode: random files, cold/hot cache, true write
# More accurate but slower - good for weekly comparisons
full_test = false
num_files = 3       # Number of 10MB random files
file_size_mb = 10   # Size per file

# ─── Paths to test ─────────────────────────────────────────────────────
# Each path starts on this host. `source` is optional; a path whose source
# names another host is left to the nomad running there.
# path_type labels the path: 'switch' (campus network), 'direct'
# (point-to-point baseline), anything else you like.

[[collectors.network_perf.network_tests]]
dest = "storage-server"
path_type = "switch"

# Direct point-to-point connection (baseline, no switch)
# [[collectors.network_perf.network_tests]]
# dest = "10.0.0.1"        # Private IP on direct cable
# path_type = "direct"
# user = "root"            # only for the SSH throughput fallback


# ─────────────────────────────────────────────────────────────────────────────
# [database] — Where NØMAÐ stores its operational data.
# ─────────────────────────────────────────────────────────────────────────────

[database]
# SQLite database filename (relative to [general] data_dir) or absolute path.
# Default is "nomad.db" inside data_dir.
#
# Examples:
#   path = "nomad.db"               # -> data_dir/nomad.db (default)
#   path = "mydb.sqlite"            # -> data_dir/mydb.sqlite
#   path = "/var/lib/nomad/prod.db" # absolute, used as-is
path = "nomad.db"


# ─────────────────────────────────────────────────────────────────────────────
# [ml] — Machine learning predictions and continuous learning.
# ─────────────────────────────────────────────────────────────────────────────

[ml]
# Enable ML-based job failure prediction and resource forecasting.
enabled = true

# Number of training epochs for the ensemble model.
epochs = 100

# Where trained models live, relative to [general] data_dir or absolute path.
models_dir = "models"

[ml.learning]
# Continuous learning strategy:
#   "count" -- retrain after N new jobs
#   "time"  -- retrain every N hours
#   "drift" -- retrain when data drift is detected
strategy = "count"

# Retrain after this many new jobs (for "count" strategy).
job_threshold = 100

# Retrain every N hours (for "time" strategy).
interval_hours = 6

# Minimum jobs required before training can begin.
min_jobs = 50


# ─────────────────────────────────────────────────────────────────────────────
# [slurm] — Optional integration with SLURM's prolog/epilog hooks for
# real-time job scoring. Only relevant if you want NØMAÐ to evaluate
# jobs as they enter the queue.
# ─────────────────────────────────────────────────────────────────────────────

[slurm]
# Path to SLURM binaries if not in $PATH. Leave commented to use $PATH.
# bin_path = "/usr/bin"

[slurm.prolog]
# Score jobs in real time as they're submitted via slurmctld prolog hook.
# Requires installing the NØMAÐ prolog script into SLURM's prolog config.
enabled = false

# Risk threshold (0.0 - 1.0): jobs scoring above this are logged for review.
risk_threshold = 0.7

# Where to log high-risk job submissions.
log_file = "/var/log/nomad/high_risk_jobs.log"


# ─────────────────────────────────────────────────────────────────────────────
# [signals.*] — Site policy for the insight engine's signal generators.
#
# These thresholds control what appears in the daily brief (nomad insights
# brief) and on the dashboard. They are SEPARATE from [alerts.thresholds.*],
# which controls the realtime dispatch path (email, Slack).
#
# Two namespaces, two purposes:
#   [signals.*]            -> what shows in the brief / dashboard
#   [alerts.thresholds.*]  -> what triggers immediate notifications
#
# Sites typically want both, often with the same values. Tune separately
# when you want digest visibility without paging, or vice versa.
# ─────────────────────────────────────────────────────────────────────────────

[signals.node_state]
# State-string substrings (case-insensitive). Matching order:
# ignore -> critical -> warning -> fallback (warning).
#
# Defaults cover Slurm composite states (e.g. "DOWN+NOT_RESPONDING",
# "MIXED+DRAIN") and common vocabulary from PBS/Torque and LSF.
critical_states  = ["DOWN", "NOT_RESPONDING", "FAIL", "OFFLINE", "UNREACH"]
warning_states   = ["DRAIN", "DRNG", "DRAINING", "CLOSED", "UNAVAIL"]

# States to never surface, even when the collector flags is_healthy=0.
# Useful for sites that treat e.g. POWERED_DOWN as routine, not incident.
ignore_states    = []

# Fire a "multiple nodes unhealthy" rollup signal at the top of the brief
# when more than this many nodes are currently unhealthy. Set high for
# large clusters (5-10), low for small (1-2). Set 0 to disable.
summary_threshold = 3


# ─────────────────────────────────────────────────────────────────────────────
# [alerts.node_state] — Realtime dispatch policy for node-state changes.
# Mirrors [signals.node_state] but controls email/Slack/webhook dispatch.
# Set enabled=false to skip dispatch entirely (the digest will still surface).
# ─────────────────────────────────────────────────────────────────────────────

[alerts.node_state]
enabled = true
critical_states = ["DOWN", "NOT_RESPONDING", "FAIL", "OFFLINE", "UNREACH"]
warning_states  = ["DRAIN", "DRNG", "DRAINING", "CLOSED", "UNAVAIL"]
ignore_states   = []

[energy]
# Energy consumption, waste, and carbon-footprint monitoring (nomad energy).
enabled = true

# Power estimation (used when DCGM power_draw_w is unavailable)
cpu_tdp_watts    = 150     # per-socket CPU TDP, watts
cores_per_socket = 32      # cores per socket, for per-core power
overhead_factor  = 1.3     # PUE-like multiplier (cooling, network, storage)

# Utilization assumptions (CPU energy is estimated, not metered)
cpu_assumed_util  = 0.4    # fraction of allocated CPU actually used
cpu_idle_fraction = 0.3    # idle draw of an unused core, as fraction of per-core TDP

# Carbon intensity
carbon_source = "epa_egrid"   # epa_egrid | iea | manual
carbon_region = "SRVC"        # eGRID subregion (Virginia); or country code if iea
# carbon_intensity_g_per_kwh = 380   # manual override; use with carbon_source = "manual"
