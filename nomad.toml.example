# NØMAÐ Configuration File
# Copy this file to nomade.toml and customize for your environment

# ============================================
# GENERAL SETTINGS
# ============================================

[general]
# Name of this cluster (used in alerts and reports)
cluster_name = "my-cluster"

# Directory for NØMAÐ data (database, logs)
data_dir = "/var/lib/nomade"

# Log level: DEBUG, INFO, WARNING, ERROR
log_level = "INFO"

# Log file (empty for stdout only)
log_file = "/var/log/nomade/nomade.log"

# Daemon PID file
pid_file = "/var/run/nomade/nomade.pid"

# ============================================
# COLLECTORS
# ============================================

[collectors]
# Each collector is turned on or off in its own table:
#
#   [collectors.nfs]
#   enabled = false
#
# On unless turned off: disk, slurm, job_metrics, iostat, mpstat, vmstat,
#   node_state, gpu, nfs, groups
# Off unless turned on: interactive, workstation, per_user, storage,
#   network_perf, cloud.aws, preemptions, clock, modules, job_live
#
# (An `enabled = [...]` list here is not read.) `nomad collectors` shows,
# on any host, which ones run, why, and whether they collect anything.

# Default collection interval in seconds. Each [collectors.<name>]
# subtable can override this with its own `interval = N`.

# ============================================
# DISK COLLECTOR
# ============================================

[collectors.disk]
interval = 300  # Every 5 minutes
# Filesystems to monitor
filesystems = [
    "/",
    "/home",
    "/scratch",
    # "/project",
]

# Enable quota tracking
quota_enabled = true

# Command to get quota information
# Options: "quota", "lfs quota" (Lustre), "custom"
quota_backend = "quota"

# For custom quota command
# quota_command = "/usr/local/bin/get_quota.sh"

# Fill forecast: each reading fits the last N hours of readings with a line
# and says when the filesystem will be full ([alerts.thresholds.disk]).
forecast_window_hours = 6

# Large file detection
large_file_threshold_gb = 100
scan_for_large_files = false  # Can be slow on large filesystems

# ============================================
# SLURM COLLECTOR
# ============================================

[collectors.slurm]
interval = 60   # Every minute
# Path to SLURM commands (if not in PATH)
# slurm_bin_path = "/usr/bin"

# Partitions in the queue snapshot (empty = all); jobs come from every partition
partitions = []

# Job age limit for history queries (days)
job_history_days = 30

# Stuck job threshold (days)
stuck_job_threshold_days = 7

# Zombie process detection
check_zombies = true

# ============================================
# NODE COLLECTOR
# ============================================

[collectors.nodes]
interval = 120  # Every 2 minutes
# How to check node health
# Options: "slurm" (sinfo only), "ssh" (SSH to each node)
health_check_method = "slurm"

# SSH settings (if health_check_method = "ssh")
ssh_user = "root"
ssh_timeout = 10
ssh_parallel = 4

# Temperature monitoring
monitor_temperatures = true
cpu_temp_warning = 80
cpu_temp_critical = 90
gpu_temp_warning = 83
gpu_temp_critical = 90

# NFS health check
check_nfs_mounts = true
nfs_mount_points = ["/home", "/scratch"]

# Services to check (via systemctl)
check_services = ["slurmd", "munge"]

# The policy watch (1.19): tunnels, ssh reverse forwards, VS Code tunnels,
# miners, relays, and services open to the network on login nodes, from
# /proc, here and on every node Slurm lists (over ssh), every 15 minutes.
# Keeps no command lines. See docs/policy_watch.md; `nomad watch list`.
# [collectors.policy_watch]
# enabled = true
# nodes = "slurm"
# ignore_programs = []
# owners_in_alerts = false
# An ssh -R to a server listed here (1.19.1) is verified -- listed, not
# alerted -- when what the kernel shows agrees: its account's connections
# go only there (ports below 1024, or the one given), into the cluster
# below port 1024, or to a system service on that host; no proxy or jump;
# loopback on the far end. It stays so while the same ssh runs. Names are
# resolved by the collector, not by anyone's ssh config.
# trusted_hosts = ["vadur"]               # or "vadur:2222", "172.28.122.224", "10.9.0.0/24"
# Public ranges that are campus: only a label ("on campus" or "connects
# outside"); private addresses beyond the cluster are campus already.
# campus_networks = ["141.166.0.0/16", "192.67.49.0/24"]
# The cluster's own networks are found on each host (private, reached
# directly, on an interface with no default route); list one a node
# routes out through, or with a spare default route on it:
# cluster_networks = ["10.1.1.0/24"]
# AI agents and reselling (1.20): an AI agent command-line program (Claude
# Code, Codex, aider, ...) is listed, not alerted -- `nomad watch list --all`
# shows them; AI use is not misuse. `agents` adds to the built-in list.
# agents = []                             # e.g. ["myorg-agent", "llm"]
# A process that reaches root whose parent is a user's and isn't a sanctioned
# helper (sudo, su, pkexec, ...) is flagged (escalation, critical). To catch
# reselling, turn on compute-node services too; then a service open to the
# network on a node is a warning (a port in the ephemeral range is listed):
# listeners_on_nodes = true
# What needs root (off by default): a helper (scripts/watch_root_probe.py) run
# as root by cron on each node writes a counts-only JSON that the probe reads
# here -- failed sudo/su per account, new setuid files in user-writable
# places. Give the same path the helper writes. See docs/policy_watch.md.
# root_report = "/var/lib/nomad-watch/root_signals.json"
# Failed sudo/su and new setuid files, read unprivileged (1.23) where the
# collector's account may: watch_auth reads the auth log (e.g. /var/log/secure
# where it is group-readable; a no-op where it isn't), setuid_roots scans the
# dirs you list for a person's setuid files (off until set). No root, no cron.
# watch_auth = true
# auth_log = ""
# auth_window_hours = 24
# setuid_roots = ["/localscratch"]
# GPU workstations (1.21): list GPU boxes to ask over ssh (as "workstation").
# workstations = ["ml-ws01", "ml-ws02"]
# The GPU watch (on by default; nothing where there is no GPU) lists each GPU
# compute process (nvidia-smi); one reachable from the network -- it listens
# on a port open to the network, or its account also runs a tunnel/relay/
# forward -- is a warning (gpu_served): the shape of reselling or an open
# inference server. Graphics (Xorg, a browser) don't show. A context below
# gpu_min_mem (MiB) is a probe, not a workload. gpu_serve_hosts names boxes
# where serving a GPU is sanctioned (then listed, not alerted).
# watch_gpu = true
# gpu_min_mem = 256
# gpu_serve_hosts = ["shared-infer01"]
# Behaviour (1.22): the tells an AI agent (or a careless script) driving the
# cluster over the user's own ssh leaves -- which look like the user to the
# /proc watch. heavy: a user process holding real CPU (by lifetime average) on
# a login node. From the jobs table: job_burst (sbatches in a window; an array
# is one; listed, a sweep bursts too), fail_fast (jobs that FAIL in seconds),
# job_churn (the same job resubmitted and cancelled over and over).
# watch_heavy = true
# heavy_cpu = 2.0
# heavy_min_seconds = 600
# watch_jobs = true
# job_window_hours = 24
# burst_jobs = 60
# burst_minutes = 10
# fail_fast_jobs = 15
# fail_fast_seconds = 60
# churn_repeats = 8

# Compute nodes' local disks (1.14): on the head node, df of each path on
# every node Slurm lists (not down), over ssh, every 30 minutes; alerts at the
# [alerts.thresholds.disk] percentages, one per node and path.
# [collectors.node_disks]
# enabled = true
# paths = ["/localscratch"]
# interval_minutes = 30
# parallel = 8                   # nodes asked at once
# timeout = 10                   # seconds a node has to answer
# max_seconds = 120              # a sweep stops asking after this long
# ssh_user = "..."               # default: this account
# nodes = ["cn01", "cn02"]       # default: every node sinfo lists
# Who has the data (1.14.3): each path totalled by owner on a few nodes per
# sweep (full disks at every sweep, the others every 6 hours); the largest
# owners named in the disk's alert.
# owners = true
# owners_every_hours = 6
# owners_above = 80
# owners_seconds = 60            # per path
# owners_top = 5
# owners_per_sweep = 8           # default and most: parallel
# owners_in_alerts = true        # false: no names in alerts (Slack, webhooks)

# ============================================
# LICENSE COLLECTOR
# ============================================

[collectors.licenses]
interval = 300  # Every 5 minutes
# License servers to monitor

[[collectors.licenses.servers]]
name = "matlab"
type = "flexlm"           # flexlm, rlm, or custom
host = "license.example.edu"
port = 27000
timeout = 10

[[collectors.licenses.servers]]
name = "gaussian"
type = "flexlm"
host = "license.example.edu"
port = 27001

# [[collectors.licenses.servers]]
# name = "custom_software"
# type = "custom"
# command = "/usr/local/bin/check_license.sh"
# parse_regex = "Available: (\\d+)/(\\d+)"

# ============================================
# JOB COLLECTOR
# ============================================

[collectors.jobs]
# Job metrics are collected via SLURM prolog/epilog hooks
# See scripts/prolog.sh and scripts/epilog.sh

# Path where prolog/epilog write temporary data
metrics_spool_dir = "/var/spool/nomade/jobs"

# Sample job metrics during execution (requires periodic cron job)
sample_during_job = false
sample_interval = 300  # seconds

# cgroup path for per-job metrics
cgroup_path = "/sys/fs/cgroup"

# GPU monitoring
monitor_gpus = true
nvidia_smi_path = "/usr/bin/nvidia-smi"


# ============================================
# TEMPERATURES (1.25.6)
# ============================================
# What the kernel's sensors read (/sys/class/hwmon: CPU, drives, ...), here
# or over ssh, each reading kept keep_days and each hour's low/mean/high for
# good; alerts in [alerts.temps]. Run it every minute on its own timer
# (nomad collect -C temps --once) for a sustain of minutes.
[collectors.temps]
enabled = false
# hosts = ["localhost"]              # this host; others over ssh
# workstations = true                # and the workstations the workstation collector reads
# slurm_nodes = true                 # and every node Slurm lists that answers (a head node)
# parallel = 8
# max_seconds = 50
# ssh_user = "..."                   # default: as ssh logs in
# timeout = 15
# keep_days = 30

# Power supplies, voltages and fans (1.25.8): the root helper's file
# (scripts/power_root_probe.py, by root's cron: docs/collectors.md, "Power")
[collectors.power]
enabled = false
# files = ["/var/lib/nomad-power/power.json"]
# max_age_minutes = 20

# [alerts.power]
# fans = true
# ignore = ["node03:PMBPower"]

# The jobs Slurm preempted or requeued (1.28.0), for the hub to tell the person
[collectors.preemptions]
enabled = false
# hours = 2

# How fast each CPU really runs when busy (1.27.0): a CPU braked by its board
# (a power supply lost: PROCHOT) is found the day it starts. No root.
[collectors.clock]
enabled = false
# hosts = ["localhost"]
# slurm_nodes = true                 # a head node: every node Slurm lists that answers
# workstations = true                # and the workstation collector's
# every_minutes = 15
# seconds = 0.5

# [alerts.clock]
# min_fraction = 0.5                 # low below this share of what it should give
# sustain = 2                        # readings in a row
# ignore = ["gpu0*"]

# What each running job uses now (1.32.0): its cores kept busy and the memory
# it holds, from Slurm's accounting of running jobs (sstat), for the
# Console's "In use now". A Slurm head node. sstat shows someone else's job
# only to root and Slurm's own account, so it runs as sstat_as through sudo
# (by default [actions] slurm_as below); root adds, unless the account may
# already (sudo -l): ACCOUNT ALL=(slurm) NOPASSWD: /usr/bin/sstat
[collectors.job_live]
enabled = false
# interval = 300
# sstat_as = "slurm"                 # "self": this account is root or SlurmUser

# The environment modules the cluster has (1.26.0), read daily, for the job
# scripts nomad makes ([[submit.templates]] on the hub)
[collectors.modules]
enabled = false
# module_paths = ["/usr/local/sw/modulefiles"]   # module use first: folders a login doesn't add
# min_hours = 20

# ============================================
# WORKSTATION COLLECTOR
# ============================================
[collectors.workstation]
# Enable workstation monitoring
enabled = false

# Collection interval (seconds)
interval = 300

# List of workstations to monitor
# Each workstation needs hostname and optional department. A department that
# is a lab's group (e.g. "NETID$") assigns the machine to that lab: its PI
# sees it in the Console (see [console.labs]).
[[workstations]]
hostname = "ws-physics-01"
department = "physics"

[[workstations]]
hostname = "ws-chem-lab"
department = "chemistry"

[[workstations]]
hostname = "ws-bio-analysis"
department = "biology"

# SSH settings for remote collection
ssh_timeout = 10
ssh_batch_mode = true

# ============================================
# STORAGE/NAS COLLECTOR
# ============================================
[collectors.storage]
# Enable storage/NAS monitoring
enabled = false

# Collection interval (seconds)
interval = 300

# Storage servers to monitor, reached over SSH (BatchMode: a key, no
# password prompt) unless the hostname is this host. type = "zfs" reads
# pool health and capacity (zpool); any type reads NFS exports. Capacity
# without ZFS comes from `paths` (df), never from the server's root disk.
[[collectors.storage.storage_devices]]
hostname = "nas-01"
type = "zfs"
description = "Primary ZFS storage"

[[collectors.storage.storage_devices]]
hostname = "nfs-home"
type = "nfs"
paths = ["/export/home"]
description = "Home directories NFS server"

# ZFS-specific settings
[collectors.storage.zfs]
# Monitor ARC statistics
monitor_arc = true
# Alert on scrub errors
scrub_error_alert = true
# Alert when pool capacity exceeds this percentage
capacity_warning = 80
capacity_critical = 90

# NFS-specific settings
[collectors.storage.nfs]
# Monitor NFS client connections
monitor_clients = true
# Monitor export status
monitor_exports = true

# ============================================
# PER-USER COLLECTOR (login nodes, shared hosts)
# ============================================
# Who uses this host heavily, with what, for how long. Each run averages
# CPU and I/O over the interval since the previous run; `nomad per-user`
# shows what was flagged and who used the host most.
[collectors.per_user]
enabled = false
role = "headnode"

# A process is stored (with its command line) only above one of these;
# the rest leave no row. Flags and daily per-user totals are kept; raw
# samples for sample_retention_days (0 keeps them).
floor_cpu_percent = 10
floor_memory_gb = 2
floor_io_mb_per_s = 10
sample_retention_days = 30

# Per-user CPU from systemd user slices (cgroups) where present: it also
# counts processes too short-lived to be seen between two readings.
user_slices = true

[collectors.per_user.whitelist]
min_uid = 1000                     # below this: system accounts, never flagged
users = ["slurm", "munge"]
parent_paths = ["/usr/local/sw/"]  # matched against the executable (needs root for
                                   # other users') or the script an interpreter runs
# user_commands = [["backupuser", "clusterbackup.py"]]   # command or script name

# Rules replace the defaults when given. rule_type: cpu, memory, io (one
# process), user_cpu, user_memory (all of a user's processes together).
# threshold: % of one core, GB, or MB/s. duration_seconds is a minimum.
# [[collectors.per_user.rules]]
# rule_id = "cpu_50pct_2min"
# rule_type = "cpu"
# threshold = 50
# duration_seconds = 120
# severity = "actionable"          # or "informational"

# A weekly email to each person about their own use (1.39.0): what of theirs
# a login node caught, and a pattern of jobs asking for far more than they
# use. On for everyone by default (people turn it off on My activity);
# accounts only in a course are left out. Review first: while review_to is
# set every email goes there; [] sends to people. docs/notices.md.
# [notices]
# kinds = ["login_node", "jobs"]
# every_days = 7
# link = "https://nomad.example.edu"   # the Console
# review_to = ["rc@example.edu"]       # [] sends to people
# greeting = "Hello,"
# courses = false                      # true: accounts only in a course too
# skip_users = []                      # service and admin accounts: never emailed
#
# [notices.jobs]
# days = 30
# min_jobs = 5
# severities = ["critical", "high"]
# repeat_days = 30

# What a login node's flags say about someone, told to them (1.38.0): on the
# Console's My activity and Home, and in `nomad edu me`, with the better way.
# Read where those run (the hub; a site for its own `nomad edu me`).
# [notices.login_node]
# show = true                      # false: told to no one
# days = 30                        # the last this many days
# min_minutes = 15                 # one program: held at least this long...
# min_cores = 0.5                  # ...at a CPU rule of at least this many cores
# min_memory_gb = 16               # one program's memory rule: at least this many GB
# skip_programs = ["scp", "sftp-server", "rsync", "sshd", "sshd-session", "sshd-auth"]   # moving data in or out: never told

# ============================================
# MAIL, SUPPORT AND ISSUE REPORTING
# ============================================
# These differ from one institution to the next. The CLI, the dashboard and
# the NØMAÐ Console all read them from here.

# ─── Actions ─────────────────────────────────────────────────────
# A fixed catalog of commands the Console's admins run (nomad actions list),
# on the hub or on a site through the site's `nomad agent` (the forced
# command of the hub's key: nomad agent install-key). See docs/actions.md.
[actions]
# On the hub:
# agent_key = "~/.config/nomad/agent/id_ed25519"   # the hub's key to the sites' agents
# allow_unrestricted = false         # true: also a site key without the forced command
#
# On a site (a Slurm head node): who runs scontrol to drain and resume
# nodes (1.31: nomad node drain|resume, the Console's Nodes page); off
# until set. "slurm": as Slurm's own account through sudo, where root adds
# (unless the account may already: sudo -l):
#   ACCOUNT ALL=(slurm) NOPASSWD: /usr/bin/scontrol update NodeName\=* State\=DRAIN Reason\=*, /usr/bin/scontrol update NodeName\=* State\=RESUME
#   Defaults:ACCOUNT !requiretty     # where sudo insists on a terminal (RHEL 7)
# "self": this account is a Slurm administrator. The job_live collector
# runs sstat as the same account unless [collectors.job_live] sstat_as says.
# slurm_as = "slurm"

# ─── Mail ────────────────────────────────────────────────────────
# How NØMAÐ hands mail to your institution's mail server: alert email,
# and support messages sent from the Console.
[mail]
host = "smtp.your-institution.edu"
port = 587                   # often 25 for an on-campus relay, 587 otherwise
starttls = "required"        # required | if-offered | off. "off" is meant
                             # for a mail server on this machine.
from = "hpc@your-institution.edu"   # must be an address the server accepts;
                                    # some refuse senders not in the directory
# tls_name = ""              # the name on the server's certificate, when it
                             # differs from host (a pool presenting the pool's
                             # certificate)
# extra_ca = ""              # an intermediate certificate the server fails
                             # to send; the chain must still reach a trusted root
# ca_bundle = ""             # trusted roots; default: the operating system's
# username = ""              # only if the server needs a login
# password_file = ""         # a file holding that password, readable only by
                             # you -- never the password itself

# ─── Console access ──────────────────────────────────────────────
# Who may see what in the Console, on the machine that runs it. Anyone not
# named who signs in is a viewer: their own work. Check with
# `nomad console roles NETID`.
[console.roles]
admin = []                   # NetIDs: everything, settings included
operator = []                # everything, no settings
viewer = []                  # named: their own work, whatever else says

[console.labs]
# A PI also sees the members of the labs they lead: the group named by
# group_pattern for them (when it exists), and any group listed in leads.
# Empty (the default): no labs from names, only from leads.
group_pattern = ""           # e.g. "{netid}$" where a faculty member's group
                             # is their NetID followed by $
leads = {}                   # e.g. { NETID = ["chemlab$"] }
# not_labs = []              # groups never a lab, whatever else says: a service
                             # account's, a mistyped one (`nomad lab hide LAB`)

# A lab's own workstations and storage, which its PI also sees (people
# outside the lab show as "another user" there). One table per lab group:
# [console.labs.resources."NETID$"]
# workstations = ["adam", "eve"]
# storage = ["sarahvaughan"]           # a server, or "server:/export"

# A lab's research assistants see it as its PI does, while they are one of
# its members (`nomad lab assistant LAB NETID` writes this). A group made a
# course this term ([console.courses]) is a class, not a lab, that term.
# [console.labs.assistants]
# "NETID$" = ["eve"]

# Each term, a lab's PI says who is still in it, on My lab; the answers are
# ARC's to-do (`nomad lab check`, docs/lab-check.md). Off until opens is set.
# mail_domain, send_from and review_to not given here are report.toml's.
# [console.labs.check]
# opens = ["09-15", "02-01", "06-15"]   # MM-DD: the day each term's check opens
# remind_days = [14, 28]                # reminders to PIs who haven't answered
# closes_days = 42                      # unanswered by then: on ARC's to-do
# claim_days = 120                      # condo users of these days are asked about
# link = "https://nomad.example.edu/lab"   # where PIs answer, in the email
# mail_domain = "example.edu"           # a PI's address: NETID@mail_domain
# send_from = "Research Computing <rc@example.edu>"
# review_to = ["rc@example.edu"]        # while set, every email goes here instead
# db = "/home/nomad/.local/share/nomad/lab_check.db"   # default: beside combined.db
# not_sites = ["teaching"]              # sites whose groups it leaves out (a teaching server's course groups)
# salutation = "Dr. {last}"             # the greeting: "Dear Dr. Parish," ({first}, {last}, {name})
# names = { jsmith = "Jane Smith" }     # where the account's full name (getent passwd) won't do
#                                       # (nomad lab check names --set finds and asks for them)
# directory = { uri = "ldap://ldap.example.edu", base = "ou=people,dc=example,dc=edu" }   # names --set, no login (default: ldap.conf)
# signature = ["Research Computing", "Example University"]   # default: [console.branding]
# contact = "Questions: rc@example.edu" # default: report.toml's [report.labs] contact

# What My lab's Needs attention lists (docs/facts.md); these are the defaults.
# [console.labs.attention]
# days = 7                 # the jobs, and the growth of data, looked at
# waiting_hours = 24       # a job waiting longer for something that won't change by itself
# waiting_max_days = 60    # ... and no longer (an old record, not a job)
# failing_jobs = 3         # failed jobs, at least half of a member's that ran to an end
# storage_pct = 90         # a lab storage server this full
# holders = 3              # the lab's biggest holders of data named (0: none),
# holder_gb = 100          # each holding this much or more (GB = 10^9 bytes),
# growth_gb = 100          # and anyone whose data grew this much in `days` (0: none)
# quota_pct = 90           # a member this close to a quota
# over_cpu_hours = 100     # core-hours held by measured jobs ...
# over_cpu_pct = 25        # ... and used under this share of them
# over_memory_pct = 20     # memory used under this share of what jobs asked for,
# over_memory_jobs = 3     # over this many measured jobs
# workstation_hours = 2    # a lab workstation silent this long

# A storage server's name and a note, shown wherever its exports are. The
# server as the mounts name it (often an address). Say when everyone shares
# it, or its use reads as the lab's own.
# [console.storage."10.0.0.28"]
# name = "sarahvaughan"
# note = "community $HOME, all users"

# What each machine is (a head node, the hub, a NAS, a cluster), shown beside
# its name in the Console and nomad facts; `nomad machine note NAME "..."`.
# [console.machines."labhead1"]
# note = "the Smith lab's head node: collects its workstations"

# ─── Support ─────────────────────────────────────────────────────
# Where people's questions go, e.g. the Console's "Contact support".
[support]
email = "hpc-support@your-institution.edu"
institution = "Your Institution"     # shown in reports and system information
# user_email_domain = "your-institution.edu"   # replies go to
                                               # <username>@<this domain>

# ─── Issue reporting ─────────────────────────────────────────────
# Bug reports and feature requests to the NØMAÐ project on GitHub
# (`nomad issue`, and the Console's Report Issue page for administrators).
[issue_reporting]
enabled = true
# github_token_file = ""     # a file holding a fine-grained token that can
                             # only create issues; without one, NØMAÐ opens
                             # a pre-filled page in the browser instead
# contact_email = ""         # who the NØMAÐ maintainers may reply to

# ============================================
# ALERTS
# ============================================

[alerts]
# Alert dispatch configuration.
#
# Only signals at or above min_severity are dispatched. Each condition (a
# disk path, a mount, a GPU, a node) is raised when it appears or gets
# worse, then reminded of once every reminder_hours while it lasts -- not on
# every collection run. Not seen for episode_gap_minutes, it has ended.
min_severity = "warning"     # info | warning | critical
reminder_hours = 24
episode_gap_minutes = 60

# ─── Email dispatch ──────────────────────────────────────────────
# Sent through [mail] above. To enable: fill in [mail], put your
# address in recipients, then set enabled = true.
[alerts.email]
enabled = false
recipients = ["hpc-admin@your-institution.edu"]
# Only if alerts must go through a different server than [mail]: any of
# [mail]'s keys here (host, port, starttls, from, ...) override it.

# ─── Slack dispatch ──────────────────────────────────────────────
[alerts.slack]
enabled = false
webhook_url = ""             # paste your Slack incoming webhook URL
channel = "#hpc-alerts"
username = "NØMAÐ"

# ─── Generic webhook ─────────────────────────────────────────────
[alerts.webhook]
enabled = false
url = ""
# auth_token = ""             # passed as Authorization: Bearer <token>

# ============================================
# ALERT THRESHOLDS
# ============================================

[alerts.thresholds.disk]
used_percent_warning = 80
used_percent_critical = 95
# Forecast: full within this many hours at the fill rate of the last
# forecast_window_hours ([collectors.disk], default 6).
full_within_hours_warning = 72
full_within_hours_critical = 24
# Past used_percent_critical, only when full within this many hours.
full_within_hours_past_critical = 6

[alerts.thresholds.nfs]
retrans_percent_warning = 1.0
retrans_percent_critical = 5.0
avg_rtt_ms_warning = 50
avg_rtt_ms_critical = 100

# Node state alerts (down, drained, failing) come from the node_state
# collector and need no thresholds.

# ============================================
# DERIVATIVE ALERT THRESHOLDS
# ============================================

[alerts.derivatives]
# Disk acceleration (GB/day²)
disk_acceleration_warning = 1.0
disk_acceleration_critical = 5.0

# Queue acceleration (jobs/hour²)
queue_acceleration_warning = 5
queue_acceleration_critical = 20

# Failure rate acceleration
failure_rate_acceleration_warning = 0.01  # 1% increase per day

# NFS latency acceleration (ms/hour²)
nfs_latency_acceleration_warning = 1.0

# ============================================
# PREDICTION ENGINE
# ============================================

[prediction]
# Enable/disable prediction features
enabled = true

# Minimum jobs before training models
min_jobs_for_training = 100

# Similarity threshold for network edges
similarity_threshold = 0.85

# Health score threshold for success/failure classification
health_threshold = 0.5

# Model retraining interval (days)
retrain_interval_days = 7

# Maximum jobs to keep in similarity network
max_network_jobs = 10000

# Anomaly detection threshold (distance to nearest simulation)
anomaly_distance_threshold = 0.15

# ============================================
# SIMULATION
# ============================================

[prediction.simulation]
# Number of simulated jobs for coverage analysis
n_simulated = 1000

# Rerun simulation on this interval (days)
simulation_interval_days = 7

# Alert if coverage drops below threshold
coverage_warning_percent = 90

# ============================================
# DASHBOARD
# ============================================

[dashboard]
# Web dashboard settings
enabled = true
# Bind to loopback by default. Set to "0.0.0.0" to expose to other
# hosts on the network (e.g. for centralized monitoring servers).
host = "127.0.0.1"
port = 8080

# Authentication (optional)
auth_enabled = false
# auth_users = { admin = "hashed_password" }

# SSL (optional)
ssl_enabled = false
# ssl_cert = "/etc/ssl/certs/nomade.crt"
# ssl_key = "/etc/ssl/private/nomade.key"

# Real-time update interval (milliseconds)
update_interval_ms = 5000

# ============================================
# DATA RETENTION
# ============================================

[retention]
# How long to keep historical data

# Filesystem snapshots
filesystem_days = 365

# Node metrics
node_metrics_days = 90

# Job data
job_data_days = 365

# Alerts
alert_days = 180

# Similarity edges (can be large)
similarity_days = 90

# Run cleanup on this schedule (cron format)
cleanup_schedule = "0 3 * * *"  # 3 AM daily

# ============================================
# INTERACTIVE SERVERS
# ============================================

[interactive]
# Monitor interactive computing servers (RStudio, Jupyter)
# These are non-SLURM servers where users run sessions directly
enabled = false

# Collection interval (seconds)
collect_interval = 300  # Every 5 minutes

# Thresholds for alerts
idle_session_hours = 24      # Sessions idle longer than this are "stale"
memory_hog_mb = 4096         # Sessions using more than this are flagged
max_idle_sessions = 5        # Users with more idle sessions get flagged

# Define interactive servers to monitor
# Each server needs a unique identifier

# [[interactive.servers]]
# id = "interactive-server-1"
# name = "Interactive Server"
# description = "RStudio and Jupyter server"
# 
# # Connection method: "local" (run on this machine) or "ssh" (remote)
# method = "local"
# 
# # SSH settings (only if method = "ssh")
# # ssh_host = "server.example.edu"
# # ssh_user = "nomade"
# # ssh_key = "/home/nomade/.ssh/id_rsa"
# # ssh_timeout = 30

# ============================================
# NETWORK PERFORMANCE COLLECTOR
# ============================================
# Latency and packet loss from this host to the hosts you list, every run
# (ten pings, about two seconds per path). Throughput only if you turn it
# on: it puts real traffic on the wire for iperf_duration seconds, at most
# once per throughput_interval per path, and needs `iperf3 -s` running on
# the destination (otherwise it times an SSH copy, which encryption may
# limit below what the network carries).
# For NFS client statistics, see [collectors.nfs] (nfsiostat).

[collectors.network_perf]
enabled = false
ping_count = 10

throughput = false
throughput_interval = 3600   # seconds between throughput tests, per path
iperf_duration = 10

# Full fileiotest mode: random files, cold/hot cache, true write
# More accurate but slower - good for weekly comparisons
full_test = false
num_files = 3       # Number of 10MB random files
file_size_mb = 10   # Size per file

# ─── Paths to test ─────────────────────────────────────────────────────
# Each path starts on this host. `source` is optional; a path whose source
# names another host is left to the nomad running there.
# path_type labels the path: 'switch' (campus network), 'direct'
# (point-to-point baseline), anything else you like.

[[collectors.network_perf.network_tests]]
dest = "storage-server"
path_type = "switch"

# Direct point-to-point connection (baseline, no switch)
# [[collectors.network_perf.network_tests]]
# dest = "10.0.0.1"        # Private IP on direct cable
# path_type = "direct"
# user = "root"            # only for the SSH throughput fallback


# ─────────────────────────────────────────────────────────────────────────────
# [database] — Where NØMAÐ stores its operational data.
# ─────────────────────────────────────────────────────────────────────────────

[database]
# SQLite database filename (relative to [general] data_dir) or absolute path.
# Default is "nomad.db" inside data_dir.
#
# Examples:
#   path = "nomad.db"               # -> data_dir/nomad.db (default)
#   path = "mydb.sqlite"            # -> data_dir/mydb.sqlite
#   path = "/var/lib/nomad/prod.db" # absolute, used as-is
path = "nomad.db"


# ─────────────────────────────────────────────────────────────────────────────
# [ml] — Machine learning predictions and continuous learning.
# ─────────────────────────────────────────────────────────────────────────────

[ml]
# Enable ML-based job failure prediction and resource forecasting.
enabled = true

# Number of training epochs for the ensemble model.
epochs = 100

# Where trained models live, relative to [general] data_dir or absolute path.
models_dir = "models"

[ml.learning]
# Continuous learning strategy:
#   "count" -- retrain after N new jobs
#   "time"  -- retrain every N hours
#   "drift" -- retrain when data drift is detected
strategy = "count"

# Retrain after this many new jobs (for "count" strategy).
job_threshold = 100

# Retrain every N hours (for "time" strategy).
interval_hours = 6

# Minimum jobs required before training can begin.
min_jobs = 50


# ─────────────────────────────────────────────────────────────────────────────
# [slurm] — Optional integration with SLURM's prolog/epilog hooks for
# real-time job scoring. Only relevant if you want NØMAÐ to evaluate
# jobs as they enter the queue.
# ─────────────────────────────────────────────────────────────────────────────

[slurm]
# Path to SLURM binaries if not in $PATH. Leave commented to use $PATH.
# bin_path = "/usr/bin"

[slurm.prolog]
# Score jobs in real time as they're submitted via slurmctld prolog hook.
# Requires installing the NØMAÐ prolog script into SLURM's prolog config.
enabled = false

# Risk threshold (0.0 - 1.0): jobs scoring above this are logged for review.
risk_threshold = 0.7

# Where to log high-risk job submissions.
log_file = "/var/log/nomad/high_risk_jobs.log"


# ─────────────────────────────────────────────────────────────────────────────
# [signals.*] — Site policy for the insight engine's signal generators.
#
# These thresholds control what appears in the daily brief (nomad insights
# brief) and on the dashboard. They are SEPARATE from [alerts.thresholds.*],
# which controls the realtime dispatch path (email, Slack).
#
# Two namespaces, two purposes:
#   [signals.*]            -> what shows in the brief / dashboard
#   [alerts.thresholds.*]  -> what triggers immediate notifications
#
# Sites typically want both, often with the same values. Tune separately
# when you want digest visibility without paging, or vice versa.
# ─────────────────────────────────────────────────────────────────────────────

[signals.node_state]
# State-string substrings (case-insensitive). Matching order:
# ignore -> critical -> warning -> fallback (warning).
#
# Defaults cover Slurm composite states (e.g. "DOWN+NOT_RESPONDING",
# "MIXED+DRAIN") and common vocabulary from PBS/Torque and LSF.
critical_states  = ["DOWN", "NOT_RESPONDING", "FAIL", "OFFLINE", "UNREACH"]
warning_states   = ["DRAIN", "DRNG", "DRAINING", "CLOSED", "UNAVAIL"]

# States to never surface, even when the collector flags is_healthy=0.
# Useful for sites that treat e.g. POWERED_DOWN as routine, not incident.
ignore_states    = []

# Fire a "multiple nodes unhealthy" rollup signal at the top of the brief
# when more than this many nodes are currently unhealthy. Set high for
# large clusters (5-10), low for small (1-2). Set 0 to disable.
summary_threshold = 3


# ─────────────────────────────────────────────────────────────────────────────
# [alerts.node_state] — Realtime dispatch policy for node-state changes.
# Mirrors [signals.node_state] but controls email/Slack/webhook dispatch.
# Set enabled=false to skip dispatch entirely (the digest will still surface).
# ─────────────────────────────────────────────────────────────────────────────

[alerts.node_state]
enabled = true
critical_states = ["DOWN", "NOT_RESPONDING", "FAIL", "OFFLINE", "UNREACH"]
warning_states  = ["DRAIN", "DRNG", "DRAINING", "CLOSED", "UNAVAIL"]
ignore_states   = []

# [alerts.hub] — At a site: say so when the hub that reads this site has
# stopped (1.37.0). A hub counts once it has read the site twenty times over
# a day; one silent for a week is taken as retired. docs/alerts.md.
# [alerts.hub]
# enabled = true
# after_minutes = 60               # silent this long: say so
#
# In [alerts]: maintenance_hold = false keeps this site's own alerts coming
# while its hub has declared it in maintenance (nomad maintenance, on the hub).
#
# On the hub, in [hub] (declared maintenance):
# maintenance_grace_minutes = 60   # alerts held this long after a window, for the site to come back
# maintenance_max_days = 14        # the longest window (14 at most)
#
# On the hub, in [hub] (1.40.0): how often it reads the sites. `nomad sync
# timer --apply` (as root) sets nomad-sync.timer to it, two minutes after each
# five-minute mark the sites read themselves on. No storage cost; a job that
# started shows as running within minutes.
# sync_interval_minutes = 5        # 2 to 60, minutes that divide an hour
#
# A site whose gate the hub reaches only through another host, in its
# [[hub.sites]] (1.40.0; there, nomad gate jump-key):
# gate_jump = "zeus@jonimitchell"

# [alerts.node_jobs] — A node that fails every job at start (1.25.4): among the
# jobs that started on a node in the last window_minutes, at least min_jobs
# failed within fail_fast_seconds and they are at least `share` of them, while
# the very same work (the array's other tasks, the person's jobs of the same
# name) ran on other nodes. A node already drained or down is left out. Raised
# by the node_state collector (source node_jobs).
[alerts.node_jobs]
enabled = true
window_minutes = 60
fail_fast_seconds = 60
min_jobs = 5
share = 0.8

# [alerts.temps] — CPU temperatures (1.25.6, the temps collector): the CPU
# package's own sensor (k10temp Tctl, coretemp Package id N) at or above
# warning / critical for sustain_minutes (every reading for that long). A
# host's own limits go in its own table (a CPU whose limit is lower).
# [alerts.temps]
# warning = 90
# critical = 95
# sustain_minutes = 3
# [alerts.temps.peterslabworkstation]
# warning = 85
# critical = 89

# [[submit.templates]] — Job scripts nomad makes for people with none, on the
# Console's Submit page ("No script yet? Make one"; 1.26.0, the hub's
# nomad.toml; docs/submit.md, "Making a script"). The versions offered are
# the modules the cluster has ([collectors.modules] on the cluster).
# [submit.build.spydur]
# module_paths = ["/usr/local/sw/modulefiles"]
# scratch = "/scratch/$USER/$SLURM_JOB_ID"
# [[submit.templates]]
# program = "Gaussian"
# modules = ["gaussian/*"]
# default = "gaussian/latest"
# inputs = [".gjf", ".com"]
# setup = ["export GAUSS_SCRDIR={scratch}", "mkdir -p {scratch}"]
# run = "g16 < {input} > {stem}.log"
# after = ["rm -rf {scratch}"]
# outputs = ["{stem}.log"]
# cpus = 8
# mem = "16G"
# time = "1-00:00:00"
# A template's options (1.29.0): a few choices, the first chosen unless the person picks another.
# [[submit.templates.options]]
# name = "parallel"
# label = "Runs as"
# [[submit.templates.options.choices]]
# label = "MPI processes, one a core"
# parallel = "mpi"
# [[submit.templates.options.choices]]
# label = "MPI processes of 4 threads each"
# parallel = "hybrid"
# threads_per_task = 4
# omp = true                   # export OMP_NUM_THREADS={threads}

# [edu] — Job scores (docs/proficiency.md).
# [edu]
# memory_floor_gb = 2          # 1.35.2: memory requests up to this aren't judged (0: off)

# [submit.demos] — Practice runs (1.34.0; docs/demos.md): small inputs, known
# to work, that show a newcomer how a job runs. Kits come with nomad; a
# site's own (and those built there with nomad demos build) are in dirs.
# [submit.demos]
# dirs = ["/usr/local/sw/nomad-demos"]   # a site's own kits (folders of kit folders)
# bundled = true                         # also the kits that come with nomad
# into = "~/nomad-demos"                 # where nomad demos copy puts a copy: a new folder each time
# partition = { spydur = "condos" }      # where practice runs with no GPU are sent (default: the template's)
# gpu_partition = "gpunodes"             # and those with one (a name: every site)
# site_dirs = { spydur = "/usr/local/sw/nomad-demos" }   # the hub's (1.35.0): each cluster's built kits, for the Console
#                                        (there: owned by root or nomad's installer, writable by no one else)

# [submit.preemption] — Guests on condos, and the owners' first claim (1.28.0;
# the hub's nomad.toml; docs/submit.md). Slurm's configuration is the switch;
# nomad partitions --site S --condos says what would change.
# [submit.preemption]
# guest_partition = "condo_overflow"
# grace_minutes = 30
# owner_tier = 2
# notices = false              # email a person when a job of theirs is preempted

# [submit.where] — Where a job starts soonest, on the Console's Submit page
# (1.25.4; the hub's nomad.toml). [submit.where.SITE] for one site.
# [submit.where]
# guests = true                # offer other labs' condos to guests
# guest_max_days = 10          # default: report.toml's [report.policy] guest_max_days
# overflow_max_hours = 24      # a job that fits the small nodes, on big-memory ones: at most this long
# reserve_nodes = 1            # big-memory nodes kept idle for the jobs that need them
# fastest_guests = false       # "Fastest start" may pick another lab's condo by itself

[energy]
# Energy consumption, waste, and carbon-footprint monitoring (nomad energy).
enabled = true

# Power estimation (used when DCGM power_draw_w is unavailable)
cpu_tdp_watts    = 150     # per-socket CPU TDP, watts
cores_per_socket = 32      # cores per socket, for per-core power
overhead_factor  = 1.3     # PUE-like multiplier (cooling, network, storage)

# Utilization assumptions (CPU energy is estimated, not metered)
cpu_assumed_util  = 0.4    # fraction of allocated CPU actually used
cpu_idle_fraction = 0.3    # idle draw of an unused core, as fraction of per-core TDP

# Carbon intensity
carbon_source = "epa_egrid"   # epa_egrid | iea | manual
carbon_region = "SRVC"        # eGRID subregion (Virginia); or country code if iea
# carbon_intensity_g_per_kwh = 380   # manual override; use with carbon_source = "manual"

# [impact]
# What changed after NØMAÐ (nomad impact status | report | backfill).
# launch = 2026-10-19            # when people started getting NØMAÐ's feedback
# baseline_from = 2025-08-24     # where "before" starts (default: a year before launch)
# events = [                     # anything else that changes how the machines are used
#   { date = 2027-01-11, what = "four nodes added to the large partition" },
# ]
# advice_db = "/home/nomad/.nomad-console/activity.db"   # the Console's record of advice shown
# exclude_users = ["svc-backup"]   # accounts that aren't people: left out of every figure
